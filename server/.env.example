# ---------- Server ----------
NODE_ENV=development
PORT=5000
# Public URL of the React app (used in e-mail links and for CORS)
# Hostinger example: https://amused-seagreen-squirrel-59.hostingersite.com
CLIENT_URL=http://localhost:5173
# Public URL of this API (used to build absolute upload URLs in e-mails, optional)
SERVER_URL=http://localhost:5000

# ---------- MySQL ----------
# Hostinger Node.js: always use 127.0.0.1 (not localhost) and port 3306
DB_HOST=127.0.0.1
# WAMP MySQL often uses 3308; Hostinger / standard MySQL uses 3306
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=prizren_heritage

# ---------- Auth ----------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# REQUIRED in production (Hostinger hPanel → Environment variables)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Set to true when the site is served over HTTPS
COOKIE_SECURE=false
VERIFY_TOKEN_TTL_HOURS=24
RESET_TOKEN_TTL_MINUTES=60
BCRYPT_ROUNDS=12

# ---------- First administrator (created by `npm run db:seed`) ----------
ADMIN_EMAIL=admin@prizren.local
ADMIN_PASSWORD=ChangeMe!2026
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=Prizren

# ---------- E-mail (Nodemailer / SMTP) ----------
# Gmail example: SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_SECURE=false
#                SMTP_USER=you@gmail.com   SMTP_PASS=<16-char App Password>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Prizren Heritage <no-reply@prizren-heritage.local>"
# When SMTP_HOST is empty in development, an Ethereal test inbox is created
# automatically and the preview URL of each e-mail is printed in the console.
